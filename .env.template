# Plantilla de configuración de entorno (.env)
# COPIA este archivo a .env y rellena los valores reales.
# NO subas el archivo .env real al repositorio.

# --- Configuración del Servidor ---
PORT=3001
API_SECRET=

# --- Configuración Frontend / Google OAuth ---
# ID de Cliente de Google para el inicio de sesión
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Configuración de Correo (SMTP) ---
# Cuenta utilizada para enviar correos (Notificaciones, Incidencias, Intercambios)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=reserva.aulas@colegiolahispanidad.es
EMAIL_PASS=

# --- Destinatarios ---
# Correo donde se envían los reportes semanales de incidencias
EMAIL_TO=
